{
  "name": "plm-integrated",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --watch server.mjs",
    "start": "node server.mjs",
    "build": "node scripts/build-pl-css.mjs && vite build --config frontend/vite.config.js",
    "test": "node --test backend/test/*.test.js tests/*.test.mjs && vitest run --config frontend/vite.config.js",
    "check": "node scripts/verify-files.mjs && node scripts/check.mjs && npm run build",
    "backup": "node scripts/backup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "test:pl": "node --test tests/pl-regression.test.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans-thai": "^5.2.7",
    "@google/genai": "^2.27.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.3",
    "csv-parser": "^3.2.1",
    "dotenv": "^17.2.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "google-auth-library": "^10.5.0",
    "jszip": "^3.10.1",
    "lucide": "^0.577.0",
    "lucide-react": "^0.577.0",
    "multer": "^2.0.2",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pdf-to-img": "^7.0.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sweetalert2": "^11.26.3",
    "tesseract.js": "^5.0.5"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.2.0",
    "tailwindcss3": "npm:tailwindcss@^3.4.17",
    "vite": "^7.3.0",
    "vitest": "^5.0.5"
  },
  "description": "PL Brand System + QC / WO Tracking \u2014 local integrated app"
}
