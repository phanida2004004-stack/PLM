{
  "name": "wo-tracking-dashboard",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,cyan \"node --watch backend/src/server.js\" \"vite --config frontend/vite.config.js\"",
    "build": "vite build --config frontend/vite.config.js",
    "start": "node backend/src/server.js",
    "test": "node --test backend/test/*.test.js && vitest run --config frontend/vite.config.js",
    "smoke": "node scripts/smoke.mjs",
    "check": "node scripts/check.mjs && npm run build",
    "backup": "node scripts/backup.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans-thai": "^5.2.7",
    "csv-parse": "^7.0.3",
    "dotenv": "^17.2.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "google-auth-library": "^10.5.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.577.0",
    "multer": "^2.0.2",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.2.0",
    "vite": "^7.3.0",
    "vitest": "^5.0.5"
  }
}
